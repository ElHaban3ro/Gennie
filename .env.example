# Obligatoria, ruta local; relativa al directorio de ejecución.
GENNIE_DATABASE_PATH=data/gennie.sqlite3
# Milisegundos; 1..5000. Una sola conexión compartida.
GENNIE_DB_BUSY_TIMEOUT_MS=500

# Opcional: clave de OpenRouter para decisiones bajo demanda.
GENNIE_OPENROUTER_API_KEY=

# Opcional: clave de la API directa de OpenAI para el piloto de Decisions.
OPENAI_API_KEY=
