import { AboutSlint, VerticalBox } from "std-widgets.slint";
export component AboutWindow inherits Window {
    title: "Acerca de soc";
    width: 320px; height: 240px;
    VerticalBox {
        Text { text: "soc · primera base local"; horizontal-alignment: center; font-size: 20px; }
        Text { text: "Clic: despertar / descansar\nMenú soc → Salir: cerrar"; horizontal-alignment: center; }
        AboutSlint { }
    }
}
export component PresenceWindow inherits Window {
    title: "soc";
    width: 224px; height: 256px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    in-out property <bool> active: false;
    in-out property <bool> reduced-motion: false;
    in-out property <string> status-text: "";
    in-out property <bool> persist-pending: false;
    callback toggle();
    callback exit();
    callback motion-changed();
    callback about();
    out property <float> actual-diameter: diameter / 1px;
    property <length> diameter: active ? 168px : 80px;
    animate diameter { duration: reduced-motion ? 0ms : (active ? 620ms : 420ms); easing: active ? spring(0.18) : ease-in-out; }
    property <float> dream-phase: 0;
    Timer { interval: 50ms; running: !root.active && !root.reduced-motion; triggered => { root.dream-phase = Math.mod(root.dream-phase + 0.025, 1); } }
    MenuBar {
        Menu {
            title: "soc";
            MenuItem { title: "Acerca de soc"; activated => { root.about(); } }
            MenuItem { title: "Salir"; activated => { root.exit(); } }
        }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        orb := Rectangle {
            x: parent.width - self.width - 24px;
            y: parent.height - self.height - 32px;
            width: root.diameter; height: root.diameter;
            border-radius: self.width / 2;
            background: #242424;
            border-width: 1px; border-color: #555555;
            animate background { duration: root.reduced-motion ? 0ms : 300ms; }
            // Los ojos cerrados son parte de la cara, nunca se oculta la cara.
            Path {
                x: parent.width * 0.24; y: parent.height * 0.36;
                width: parent.width * 0.16; height: parent.height * 0.11;
                viewbox-width: 20; viewbox-height: 12;
                stroke: #f2f2f2; stroke-width: 3px; fill: transparent;
                commands: root.active ? "M 1 10 Q 10 -4 19 10" : "M 1 3 Q 10 14 19 3";
            }
            Path {
                x: parent.width * 0.60; y: parent.height * 0.36;
                width: parent.width * 0.16; height: parent.height * 0.11;
                viewbox-width: 20; viewbox-height: 12;
                stroke: #f2f2f2; stroke-width: 3px; fill: transparent;
                commands: root.active ? "M 1 10 Q 10 -4 19 10" : "M 1 3 Q 10 14 19 3";
            }
            Path {
                x: parent.width * 0.39; y: parent.height * 0.56;
                width: parent.width * 0.22; height: parent.height * 0.16;
                viewbox-width: 24; viewbox-height: 18;
                stroke: #f2f2f2; stroke-width: 2px; fill: transparent;
                commands: root.active ? "M 2 3 Q 12 18 22 3" : "M 8 8 L 16 8";
            }
            TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: root.active ? "soc activo. Clic para descansar" : "soc dormido. Clic para despertar";
                clicked => {
                    if ((self.mouse-x - self.width/2) * (self.mouse-x - self.width/2) + (self.mouse-y - self.height/2) * (self.mouse-y - self.height/2) <= self.width * self.width / 4) { focus.focus(); root.toggle(); }
                }
            }
        }
        if (!root.active): Text {
            x: orb.x + orb.width - 6px; y: orb.y - 10px - root.dream-phase * 24px;
            text: "z"; font-size: 16px + root.dream-phase * 8px;
            font-weight: 600; color: #a3a3a3;
            opacity: root.reduced-motion ? 0.8 : (1 - root.dream-phase);
        }
        if (!root.active): Text {
            x: orb.x + orb.width + 5px; y: orb.y - 28px - root.dream-phase * 14px;
            text: "z"; font-size: 14px; color: #a3a3a3;
            opacity: root.reduced-motion ? 0.5 : root.dream-phase;
        }
    }
}
