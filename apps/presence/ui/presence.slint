import { AboutSlint, VerticalBox, HorizontalBox, LineEdit, ComboBox, SpinBox, Button, CheckBox, TabWidget } from "std-widgets.slint";
export component TranscriptionSettings inherits Window {
    title: "Voz y asistente · soc";
    width: 440px; height: 690px;
    in-out property <bool> enabled: true;
    in property <bool> decisions-available: false;
    in property <string> decision-model-status: "Preparando Laya…";
    in property <bool> decision-model-loaded: false;
    in property <bool> decision-model-busy: false;
    in property <bool> decision-saving: false;
    in property <string> decision-settings-status: "";
    in-out property <bool> decision-preload: true;
    in-out property <bool> decision-keep-loaded: false;
    in-out property <int> decision-unload-minutes: 10;
    callback save-decisions();
    callback load-decisions();
    callback unload-decisions();
    in-out property <int> interaction-mode-index: 0;
    callback interaction-mode-changed(int);
    in property <bool> llm-available: false;
    in property <bool> llm-connected: false;
    in property <bool> llm-busy: false;
    in property <string> llm-status: "Sin conectar";
    callback connect-llm();
    in-out property <bool> llm-read-files: true;
    in-out property <bool> llm-write-files: true;
    in-out property <bool> llm-run-commands: true;
    in-out property <bool> llm-local-actions: true;
    in-out property <string> llm-model: "gpt-6-luna";
    in-out property <int> llm-effort-index: 0;
    in property <bool> llm-saving: false;
    in property <string> llm-settings-status: "";
    callback save-llm();
    in property <bool> tts-available: false;
    in-out property <bool> tts-enabled: true;
    in-out property <int> tts-voice-index: 0;
    in-out property <int> tts-speed-percent: 100;
    in property <bool> tts-saving: false;
    in-out property <string> tts-status: "";
    callback save-tts();
    callback preview-tts();
    in-out property <string> shortcut: "Ctrl+Option+Space";
    in-out property <int> mode-index: 0;
    in-out property <int> bubble-seconds: 15;
    in-out property <int> unload-minutes: 10;
    in-out property <bool> recording-shortcut: false;
    in-out property <[string]> microphones;
    in-out property <int> microphone-index: 0;
    in-out property <string> status: "";
    in-out property <string> model-status: "";
    callback save();
    callback prepare();
    callback retry-keys();
    callback cancel();
    callback capture-shortcut(bool);
    callback refresh-microphones();
    TabWidget {
        x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
        Tab {
            title: "Voz · Nemotron";
            VerticalBox {
                padding: 16px; spacing: 10px;
                Text { text: "Tu voz, por un momento"; font-size: 21px; font-weight: 600; }
                Text { text: "Español · Nemotron · audio y texto temporales"; font-size: 12px; }
                CheckBox { text: "Activar transcripción"; checked <=> root.enabled; }
                HorizontalBox {
                    Text { text: "Atajo"; width: 100px; vertical-alignment: center; }
                    Button { text: root.recording-shortcut ? "Pulsa las teclas · Esc cancela" : root.shortcut; clicked => { root.capture-shortcut(!root.recording-shortcut); } }
                }
                ComboBox { model: ["Mantener pulsado para hablar", "Pulsar para iniciar y terminar"]; current-index <=> root.mode-index; }
                Text { text: "Al terminar de hablar"; font-size: 12px; }
                ComboBox {
                    model: ["Conversar con SOC", "Solo transcribir", "Control local con Laya"];
                    current-index <=> root.interaction-mode-index;
                    selected => { root.interaction-mode-changed(self.current-index); }
                }
                Text { text: "Micrófono de entrada"; font-size: 12px; }
                HorizontalBox {
                    ComboBox { model: root.microphones; current-index <=> root.microphone-index; }
                    Button { text: "Actualizar"; clicked => { root.refresh-microphones(); } }
                }
                HorizontalBox {
                    Text { text: "Borrar globo después de"; vertical-alignment: center; }
                    SpinBox { value <=> root.bubble-seconds; minimum: 2; maximum: 30; }
                    Text { text: "s"; vertical-alignment: center; }
                }
                HorizontalBox {
                    Text { text: "Liberar Nemotron tras"; vertical-alignment: center; }
                    SpinBox { value <=> root.unload-minutes; minimum: 0; maximum: 10; }
                    Text { text: "min"; vertical-alignment: center; }
                }
                Text { text: "Minutos sin hablar antes de liberar la memoria. 0 libera al terminar."; wrap: word-wrap; font-size: 12px; }
                Text { text: root.model-status; wrap: word-wrap; font-size: 12px; }
                Text { text: root.status; wrap: word-wrap; font-size: 12px; }
                HorizontalBox {
                    Button { text: "Activar atajo"; clicked => { root.retry-keys(); } }
                    Button { text: "Preparar modelo"; clicked => { root.prepare(); } }
                }
                HorizontalBox {
                    Button { text: "Liberar Nemotron"; clicked => { root.cancel(); } }
                    Button { text: "Guardar voz"; clicked => { root.save(); } }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Tab {
            title: "Asistente · IA";
            VerticalBox {
                padding: 16px; spacing: 7px;
                Text { text: "Conversación con SOC"; font-size: 21px; font-weight: 600; }
                Text { text: "Proveedor actual: Codex"; font-size: 12px; }
                Text { text: "Las transcripciones finales se envían al mismo hilo de conversación. Se reanuda al abrir soc de nuevo."; wrap: word-wrap; font-size: 12px; }
                Text { text: "Modelo de Codex"; font-size: 12px; }
                LineEdit { text <=> root.llm-model; enabled: root.llm-available && !root.llm-saving; }
                Text { text: "Esfuerzo de razonamiento"; font-size: 12px; }
                ComboBox { model: ["Bajo", "Medio", "Alto", "Muy alto", "Máximo", "Ultra"]; current-index <=> root.llm-effort-index; enabled: root.llm-available && !root.llm-saving; }
                CheckBox { text: "Leer archivos locales"; checked <=> root.llm-read-files; enabled: root.llm-available && !root.llm-saving; }
                CheckBox { text: "Escribir archivos locales"; checked <=> root.llm-write-files; enabled: root.llm-available && !root.llm-saving; }
                CheckBox { text: "Ejecutar comandos y procesos"; checked <=> root.llm-run-commands; enabled: root.llm-available && !root.llm-saving; }
                CheckBox { text: "Controlar otras apps y navegador"; checked <=> root.llm-local-actions; enabled: root.llm-available && !root.llm-saving; }
                Text { text: "El control de apps requiere comandos y permisos de macOS."; wrap: word-wrap; font-size: 12px; }
                Text { text: "La búsqueda web permanece activada. Plugins y apps conectadas se configurarán después."; wrap: word-wrap; font-size: 12px; }
                Button { text: root.llm-saving ? "Guardando…" : "Guardar Codex"; enabled: root.llm-available && !root.llm-saving && !root.llm-busy; clicked => { root.save-llm(); } }
                Text { text: root.llm-settings-status; wrap: word-wrap; font-size: 12px; }
                Text { text: root.llm-connected ? "Conectado" : "Sin conexión"; font-size: 14px; }
                Text { text: root.llm-status; wrap: word-wrap; font-size: 12px; }
                Button { text: root.llm-busy ? "Conectando…" : "Conectar"; enabled: root.llm-available && !root.llm-busy && !root.llm-connected; clicked => { root.connect-llm(); } }
                Text { text: "Si falta la sesión de ChatGPT, inicia sesión con `codex login` en Terminal y vuelve a conectar."; wrap: word-wrap; font-size: 12px; }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Tab {
            title: "Salida · Kokoro";
            VerticalBox {
                padding: 16px; spacing: 12px;
                Text { text: "Voz de SOC"; font-size: 21px; font-weight: 600; }
                Text { text: "Kokoro-82M con MLX · procesamiento local"; wrap: word-wrap; font-size: 12px; }
                if root.tts-available: VerticalBox {
                    spacing: 12px;
                    CheckBox { text: "Leer todas las respuestas del asistente"; checked <=> root.tts-enabled; }
                    Text { text: "Voz en español"; font-size: 12px; }
                    ComboBox { model: ["Dora · femenina", "Alex · masculina", "Santa · masculina"]; current-index <=> root.tts-voice-index; }
                    HorizontalBox {
                        Text { text: "Velocidad"; vertical-alignment: center; }
                        SpinBox { value <=> root.tts-speed-percent; minimum: 70; maximum: 130; }
                        Text { text: "%"; vertical-alignment: center; }
                    }
                    Text { text: "La primera reproducción descarga el modelo. Requiere Python 3.10–3.12 y kokoro-mlx instalado para SOC."; wrap: word-wrap; font-size: 12px; }
                    HorizontalBox {
                        Button { text: "Probar voz"; clicked => { root.preview-tts(); } }
                        Button { text: root.tts-saving ? "Guardando…" : "Guardar voz de SOC"; enabled: !root.tts-saving; clicked => { root.save-tts(); } }
                    }
                    Text { text: root.tts-status; wrap: word-wrap; font-size: 12px; }
                }
                if !root.tts-available: Text { text: "La voz de SOC no está disponible en esta instancia."; wrap: word-wrap; font-size: 12px; }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Tab {
            title: "Órdenes · Laya";
            if root.decisions-available: VerticalBox {
                padding: 16px; spacing: 12px;
                Text { text: "Análisis de órdenes"; font-size: 21px; font-weight: 600; }
                Text { text: "Laya multilingüe · modelo local"; font-size: 12px; }
                Text { text: "Para usar órdenes locales, elige «Control local con Laya» en la pestaña Voz."; wrap: word-wrap; font-size: 12px; }
                Text { text: root.decision-model-status; wrap: word-wrap; font-size: 12px; }
                CheckBox {
                    text: "Cargar Laya al iniciar soc";
                    checked <=> root.decision-preload;
                    enabled: !root.decision-saving;
                }
                Text { text: "La precarga se aplica al próximo inicio de soc."; wrap: word-wrap; font-size: 12px; }
                CheckBox {
                    text: "Mantener Laya cargado";
                    checked <=> root.decision-keep-loaded;
                    enabled: !root.decision-saving;
                }
                HorizontalBox {
                    Text { text: "Liberar Laya tras"; vertical-alignment: center; }
                    SpinBox {
                        value <=> root.decision-unload-minutes;
                        minimum: 1; maximum: 120;
                        enabled: !root.decision-keep-loaded && !root.decision-saving;
                    }
                    Text { text: "min"; vertical-alignment: center; }
                }
                Text {
                    text: root.decision-keep-loaded ? "Sin descarga por inactividad. Puedes liberarlo manualmente." : "Minutos desde que termina la última orden. El cambio se aplica al guardar.";
                    wrap: word-wrap; font-size: 12px;
                }
                HorizontalBox {
                    Button { text: "Cargar Laya"; enabled: !root.decision-model-loaded && !root.decision-model-busy; clicked => { root.load-decisions(); } }
                    Button { text: "Liberar Laya"; enabled: root.decision-model-loaded || root.decision-model-busy; clicked => { root.unload-decisions(); } }
                }
                Text { text: "Liberar Laya cancela la orden en curso. La siguiente orden lo cargará de nuevo."; wrap: word-wrap; font-size: 12px; }
                Text { text: root.decision-settings-status; wrap: word-wrap; font-size: 12px; }
                Button { text: root.decision-saving ? "Guardando…" : "Guardar Laya"; enabled: !root.decision-saving; clicked => { root.save-decisions(); } }
                Rectangle { vertical-stretch: 1; }
            }
            if !root.decisions-available: Text {
                x: 16px; y: 16px; width: parent.width - 32px;
                text: "El control de órdenes no está disponible en esta instancia.";
                wrap: word-wrap;
            }
        }
    }
}
export component AboutWindow inherits Window {
    title: "Acerca de soc";
    width: 320px; height: 240px;
    VerticalBox {
        Text { text: "soc · primera base local"; horizontal-alignment: center; font-size: 20px; }
        Text { text: "Clic: despertar / descansar\nArrastrar la cara: mover\nMenú soc → Salir: cerrar"; horizontal-alignment: center; }
        AboutSlint { }
    }
}
// El mismo material estático para la cara y el texto, sin copiar dos estilos.
component GlassSurface inherits Rectangle {
    in property <length> radius: 18px;
    in property <bool> show-reflection: true;
    in property <bool> subtle-light: false;
    border-radius: radius;
    // Translucidez y reflejos; no captura/desenfoca el escritorio.
    background: root.subtle-light ? @linear-gradient(135deg, #383838a8 0%, #282828c7 42%, #181818d9 100%) : @linear-gradient(135deg, #8c8c8ca8 0%, #303030c7 42%, #181818d9 100%);
    border-width: 1px;
    border-color: root.subtle-light ? @linear-gradient(135deg, #ffffff28 0%, #ffffff0a 48%, #ffffff18 100%) : @linear-gradient(135deg, #ffffffb0 0%, #ffffff24 48%, #ffffff60 100%);
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000035;
    Rectangle {
        x: 2px; y: 2px;
        width: parent.width - 4px; height: parent.height - 4px;
        border-radius: max(0px, root.radius - 2px);
        background: root.subtle-light ? transparent : @linear-gradient(160deg, #ffffff1c 0%, #ffffff00 45%, #ffffff08 100%);
        border-width: 1px; border-color: root.subtle-light ? #ffffff04 : #ffffff0d;
    }
    if root.show-reflection: Path {
        x: parent.width * 0.16; y: parent.height * 0.07;
        width: parent.width * 0.68; height: parent.height * 0.22;
        viewbox-width: 100; viewbox-height: 30;
        stroke: @linear-gradient(90deg, #ffffff00 0%, #ffffff50 50%, #ffffff00 100%);
        stroke-width: 1px; fill: transparent;
        commands: "M 2 27 Q 50 -8 98 27";
    }
    @children
}
// Un solo contorno relleno: los párpados se separan, sin reemplazar ni fundir dibujos.
component AssistantEye inherits Rectangle {
    in property <float> wake-progress;
    in property <float> eye-squeeze;
    property <float> left-edge: 1 + 3.7 * wake-progress;
    property <float> right-edge: 20 - left-edge;
    property <float> lid-center: 5 + 5 * wake-progress;
    property <float> lid-bend: 5 * (1 - wake-progress);
    property <float> lid-half-height: 1 + 7.8 * wake-progress * (1 - eye-squeeze);
    property <float> upper-lid: lid-center + lid-bend - lid-half-height;
    property <float> lower-lid: lid-center + lid-bend + lid-half-height;
    background: transparent;
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 20; viewbox-height: 20;
        fill: #f2f2f2;
        MoveTo { x: root.left-edge; y: root.lid-center; }
        CubicTo {
            x: 10; y: root.upper-lid;
            control-1-x: root.left-edge;
            control-1-y: root.lid-center + (root.upper-lid - root.lid-center) * 0.552;
            control-2-x: 10 - (10 - root.left-edge) * 0.552;
            control-2-y: root.upper-lid;
        }
        CubicTo {
            x: root.right-edge; y: root.lid-center;
            control-1-x: 10 + (root.right-edge - 10) * 0.552;
            control-1-y: root.upper-lid;
            control-2-x: root.right-edge;
            control-2-y: root.lid-center + (root.upper-lid - root.lid-center) * 0.552;
        }
        CubicTo {
            x: 10; y: root.lower-lid;
            control-1-x: root.right-edge;
            control-1-y: root.lid-center + (root.lower-lid - root.lid-center) * 0.552;
            control-2-x: 10 + (root.right-edge - 10) * 0.552;
            control-2-y: root.lower-lid;
        }
        CubicTo {
            x: root.left-edge; y: root.lid-center;
            control-1-x: 10 - (10 - root.left-edge) * 0.552;
            control-1-y: root.lower-lid;
            control-2-x: root.left-edge;
            control-2-y: root.lid-center + (root.lower-lid - root.lid-center) * 0.552;
        }
        Close { }
    }
}
// El relleno representa memoria cargada, no actividad del micrófono ni una orden.
component ModelIndicator inherits Rectangle {
    in property <bool> loaded;
    in property <bool> voice;
    in property <string> description;
    width: 28px; height: 24px;
    background: transparent;
    accessible-role: text;
    accessible-label: description;
    Path {
        x: 5px; y: 3px; width: 18px; height: 18px;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.loaded ? #f2f2f2 : #bcbcbc;
        stroke-width: 1.5px;
        fill: root.loaded ? #f2f2f2 : transparent;
        commands: root.voice ?
            "M 12 2 C 9.8 2 8 3.8 8 6 L 8 11 C 8 13.2 9.8 15 12 15 C 14.2 15 16 13.2 16 11 L 16 6 C 16 3.8 14.2 2 12 2 Z" :
            "M 12 2 L 14.7 9.3 L 22 12 L 14.7 14.7 L 12 22 L 9.3 14.7 L 2 12 L 9.3 9.3 Z";
    }
    if root.voice: Path {
        x: 5px; y: 3px; width: 18px; height: 18px;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.loaded ? #f2f2f2 : #bcbcbc;
        stroke-width: 1.5px; fill: transparent;
        commands: "M 5 10 L 5 11 C 5 15 8.1 18 12 18 C 15.9 18 19 15 19 11 L 19 10 M 12 18 L 12 22 M 8 22 L 16 22";
    }
    Tooltip { text: @markdown("\{root.description}"); }
}

component ActionButton inherits Rectangle {
    in property <bool> busy: false;
    in property <bool> history: false;
    callback clicked();
    width: 28px; height: 28px;
    border-radius: self.width / 2;
    border-width: 1px;
    border-color: root.busy ? #ffffff38 : area.has-hover ? #f2f2f2ba : #ffffff78;
    background: root.busy ? #27272760 : area.has-hover ? #555555b8 : #27272788;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    Path {
        x: 4px; y: 4px; width: 20px; height: 20px;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.busy ? #f2f2f280 : #f2f2f2;
        stroke-width: 1.6px; fill: transparent;
        commands: root.history ?
            "M 12 3 A 9 9 0 1 1 11.99 3 Z M 12 7 V 12 L 16 14" :
            "M 4 4 H 20 Q 22 4 22 6 V 15 Q 22 17 20 17 H 10 L 6 21 V 17 H 4 Q 2 17 2 15 V 6 Q 2 4 4 4 Z M 12 7 V 14 M 8.5 10.5 H 15.5";
    }
    area := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.history ? "Abrir chat" : "Nuevo chat";
        clicked => { if (!root.busy) { root.clicked(); } }
    }
    Tooltip { text: root.history ? @markdown("Abrir chat") : @markdown("Nuevo chat"); }
}

export struct ChatBubble { title: string, text: string, from-user: bool }
export struct ChatSource { label: string, url: string }
export struct HistoryMessage { title: string, text: string, time: string, from-user: bool, system: bool, sources: [ChatSource] }
export struct IndicatorBounds { x: float, y: float, width: float, height: float }
export component PresenceWindow inherits Window {
    title: "soc";
    width: 568px; height: 980px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    in-out property <bool> active: false;
    in-out property <bool> speech-active: false;
    in-out property <bool> reduced-motion: false;
    in-out property <float> pointer-gaze-x: 0;
    in-out property <float> pointer-gaze-y: 0;
    property <float> gaze-x: active && !reduced-motion ? pointer-gaze-x : 0;
    property <float> gaze-y: active && !reduced-motion ? pointer-gaze-y : 0;
    animate gaze-x { duration: reduced-motion ? 0ms : 240ms; easing: ease-out; }
    animate gaze-y { duration: reduced-motion ? 0ms : 240ms; easing: ease-out; }

    in-out property <string> status-text: "";
    in-out property <bool> persist-pending: false;
    in-out property <[ChatBubble]> chat-bubbles;
    in-out property <[ChatSource]> chat-sources;
    in-out property <bool> history-open: false;
    in-out property <string> history-notice: "Cargando chat…";
    in-out property <[HistoryMessage]> history-messages;
    in-out property <string> history-draft: "";
    in-out property <string> history-send-status: "";
    in-out property <bool> transcription-available: false;
    in property <bool> llm-available: false;
    in property <bool> llm-busy: false;
    in property <bool> voice-model-loaded: false;
    in property <bool> decision-model-loaded: false;
    in property <string> voice-model-tooltip: "Nemotron · reconocimiento de voz\nNo disponible";
    in property <string> decision-model-tooltip: "Laya · análisis de órdenes\nNo disponible";
    out property <IndicatorBounds> voice-indicator-bounds: {
        x: voice-indicator.x / 1px, y: voice-indicator.y / 1px,
        width: voice-indicator.width / 1px, height: voice-indicator.height / 1px,
    };
    out property <IndicatorBounds> decision-indicator-bounds: {
        x: decision-indicator.x / 1px, y: decision-indicator.y / 1px,
        width: decision-indicator.width / 1px, height: decision-indicator.height / 1px,
    };
    out property <IndicatorBounds> new-chat-button-bounds: {
        x: new-chat-button.x / 1px, y: new-chat-button.y / 1px,
        width: active && llm-available ? new-chat-button.width / 1px : 0,
        height: active && llm-available ? new-chat-button.height / 1px : 0,
    };
    out property <IndicatorBounds> sources-panel-bounds: {
        x: source-panel.x / 1px, y: source-panel.y / 1px,
        width: !history-open && chat-sources.length > 0 ? source-panel.width / 1px : 0,
        height: !history-open && chat-sources.length > 0 ? source-panel.height / 1px : 0,
    };
    out property <IndicatorBounds> history-button-bounds: {
        x: history-button.x / 1px, y: history-button.y / 1px,
        width: active ? history-button.width / 1px : 0,
        height: active ? history-button.height / 1px : 0,
    };
    out property <IndicatorBounds> history-panel-bounds: {
        x: history-panel.x / 1px, y: history-panel.y / 1px,
        width: active && history-open ? history-panel.width / 1px : 0,
        height: active && history-open ? history-panel.height / 1px : 0,
    };
    out property <float> history-scroll-offset: history-scroll.content-y / 1px;
    out property <float> history-scroll-maximum: max(0px, history-scroll.content-height - history-scroll.height) / 1px;
    out property <IndicatorBounds> history-scroll-track-bounds: {
        x: (history-panel.x + scrollbar-track.x) / 1px,
        y: (history-panel.y + scrollbar-track.y) / 1px,
        width: scrollbar-track.visible ? scrollbar-track.width / 1px : 0,
        height: scrollbar-track.visible ? scrollbar-track.height / 1px : 0,
    };
    out property <IndicatorBounds> history-scroll-thumb-bounds: {
        x: (history-panel.x + scrollbar-track.x + scrollbar-thumb.x) / 1px,
        y: (history-panel.y + scrollbar-track.y + scrollbar-thumb.y) / 1px,
        width: scrollbar-track.visible ? scrollbar-thumb.width / 1px : 0,
        height: scrollbar-track.visible ? scrollbar-thumb.height / 1px : 0,
    };
    callback toggle();
    callback new-chat();
    callback open-source(string);
    callback open-history();
    callback send-chat(string) -> bool;
    callback scroll-chat-to-bottom();
    callback set-chat-scroll-offset(float);
    in property <bool> manual-drag: false;
    callback begin-drag();
    callback move-drag();
    callback finish-drag();
    callback face-clicked();
    callback exit();
    callback motion-changed();
    callback about();
    callback transcription-settings();
    scroll-chat-to-bottom => {
        history-scroll.content-y = -max(0px, history-scroll.content-height - history-scroll.height);
    }
    set-chat-scroll-offset(offset) => {
        history-scroll.content-y = max(-max(0px, history-scroll.content-height - history-scroll.height), min(0px, offset * 1px));
    }
    out property <float> actual-diameter: diameter / 1px;
    property <length> base-diameter: active ? 168px : 80px;
    animate base-diameter { duration: reduced-motion ? 0ms : 350ms; easing: ease-in-out; }
    // Los gestos siguen su propio ritmo y pueden invertirse desde el valor actual.
    property <float> wake-progress: active ? 1 : 0;
    animate wake-progress { duration: reduced-motion ? 0ms : 350ms; easing: ease-in-out; }
    property <float> smile-progress: active ? 1 : 0;
    animate smile-progress { duration: reduced-motion ? 0ms : 350ms; easing: ease-in-out; }
    // Slint actualiza el reloj por frame; sin timers, IO ni reinicios de fase al hacer clic.
    property <duration> motion-time: reduced-motion ? 0ms : animation-tick();
    property <float> breath: reduced-motion ? 0 :
        0.76 * Math.sin(360deg * motion-time / 4.7s) +
        0.24 * Math.sin(360deg * motion-time / 7.3s);
    property <float> drift: reduced-motion ? 0 :
        0.72 * Math.sin(360deg * motion-time / 11.9s) +
        0.28 * Math.sin(360deg * motion-time / 17.3s);
    // Idle despierto: parpadeos breves con pausas variables y un segundo ritmo ocasional.
    // Las envolventes llegan a cero antes de reiniciar la fase, sin cortes visibles.
    property <float> blink-pulse: reduced-motion ? 0 : Math.max(0,
        1 - Math.abs(Math.mod(motion-time, 6.7s) / 1s -
            (3.2 + 0.8 * Math.sin(360deg * motion-time / 23.1s))) / 0.16);
    property <float> extra-blink-pulse: reduced-motion ? 0 : Math.max(0,
        1 - Math.abs(Math.mod(motion-time, 13.9s) / 1s -
            (10.8 + 0.6 * Math.sin(360deg * motion-time / 19.7s))) / 0.18);
    property <float> blink-envelope: Math.sin(Math.max(blink-pulse, extra-blink-pulse) * 90deg);
    property <float> eye-squeeze: blink-envelope * blink-envelope *
        wake-progress * wake-progress * wake-progress * wake-progress;
    property <length> diameter: base-diameter + (1.2 - wake-progress * 0.85) * breath * 1px;
    property <length> face-x: drift * (1 - wake-progress) * 1.4px + gaze-x * 1.6px;
    property <length> face-y: gaze-y * 1px + breath * (1.1 - wake-progress * 0.6) * 1px -
        (reduced-motion ? 0px : Math.sin(wake-progress * 180deg) * 3px);
    property <float> dream-phase: Math.mod(motion-time, 5.9s) / 5.9s;
    property <float> second-dream-phase: Math.mod(motion-time + 2.1s, 7.7s) / 7.7s;
    property <float> sleep-opacity: 1 - wake-progress;
    focus := FocusScope {
        width: parent.width; height: parent.height;
        chat-viewport := Rectangle {
            x: parent.width - self.width - 24px;
            y: 0px;
            width: 320px;
            // La respiración no debe reiniciar el desplazamiento de la pila cada frame.
            height: parent.height - 32px - root.base-diameter - 16px - source-panel.height - (root.chat-sources.length > 0 ? 8px : 0px);
            background: transparent;
            visible: !root.history-open;
            clip: true;
            chat-stack := Rectangle {
                y: chat-viewport.height - self.height;
                width: chat-viewport.width;
                height: chat-layout.preferred-height;
                background: transparent;
                animate y { duration: root.reduced-motion ? 0ms : 180ms; easing: ease-out; }
                chat-layout := VerticalLayout {
                    spacing: 10px;
                    for message in root.chat-bubbles: Rectangle {
                        background: transparent;
                        width: 320px;
                        preferred-height: body.height + 40px;
                        min-height: body.height + 40px;
                        max-height: body.height + 40px;
                        GlassSurface {
                            x: message.from-user ? 24px : 0px;
                            width: 296px;
                            height: parent.height;
                            show-reflection: false;
                            subtle-light: true;
                            radius: 18px;
                            Text { x: 16px; y: 8px; width: parent.width - 32px; height: 16px; text: message.title; color: #ffffffb0; font-family: "Helvetica Neue"; font-size: 12px; font-weight: 700; }
                            body := Text {
                                x: 16px; y: 28px; width: parent.width - 32px;
                                height: self.preferred-height;
                                text: message.text; color: #f2f2f2; font-family: "Helvetica Neue"; font-size: 16px; font-weight: 400;
                                wrap: word-wrap; overflow: clip;
                                accessible-role: text; accessible-label: message.text;
                            }
                        }
                    }
                }
            }
        }
        source-panel := Rectangle {
            x: chat-viewport.x;
            y: chat-viewport.y + chat-viewport.height + (root.chat-sources.length > 0 ? 8px : 0px);
            width: 320px;
            height: root.chat-sources.length > 0 ? 18px + root.chat-sources.length * 28px : 0px;
            visible: root.chat-sources.length > 0 && !root.history-open;
            background: transparent;
            VerticalLayout {
                spacing: 2px;
                Text { text: "FUENTES"; height: 16px; color: #f2f2f2a8; font-family: "Helvetica Neue"; font-size: 10px; font-weight: 700; }
                for source in root.chat-sources: Rectangle {
                    width: 320px; height: 26px;
                    background: transparent;
                    Text {
                        x: 8px; y: 3px; width: parent.width - 16px; height: 20px;
                        text: "↗ " + source.label;
                        color: #d4d4d4; font-family: "Helvetica Neue"; font-size: 12px;
                        overflow: elide;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Abrir fuente " + source.label;
                        clicked => { root.open-source(source.url); }
                    }
                    Tooltip { text: @markdown("Abrir fuente en el navegador"); }
                }
            }
        }
        orb := GlassSurface {
            x: parent.width - self.width - 24px;
            y: parent.height - self.height - 32px;
            width: root.diameter; height: root.diameter;
            radius: self.width / 2;
            // Rellenos suaves al despertar, curvas cerradas al descansar.
            AssistantEye {
                x: parent.width * 0.24 + root.face-x + root.gaze-x * 3.2px; y: parent.height * 0.34 + root.face-y + root.gaze-y * 2.4px;
                width: parent.width * 0.16; height: parent.height * 0.15;
                wake-progress: root.wake-progress; eye-squeeze: root.eye-squeeze;
            }
            AssistantEye {
                x: parent.width * 0.60 + root.face-x + root.gaze-x * 3.2px; y: parent.height * 0.34 + root.face-y + root.gaze-y * 2.4px;
                width: parent.width * 0.16; height: parent.height * 0.15;
                wake-progress: root.wake-progress; eye-squeeze: root.eye-squeeze;
            }
            Path {
                x: parent.width * 0.39 + root.face-x; y: parent.height * 0.56 + root.face-y + root.breath * root.sleep-opacity * 0.4px;
                width: parent.width * 0.22; height: parent.height * 0.16;
                viewbox-width: 24; viewbox-height: 18;
                stroke: #f2f2f2; stroke-width: 2px; fill: transparent;
                MoveTo { x: 8 - root.smile-progress * 6; y: 8 - root.smile-progress * 5; }
                QuadraticTo {
                    x: 16 + root.smile-progress * 6; y: 8 - root.smile-progress * 5;
                    control-x: 12; control-y: 8 + root.smile-progress * 10 + root.breath * (0.6 - root.wake-progress * 0.4);
                }
            }
            // En macOS el marco transparente puede salir de pantalla al mover la cara.
            WindowMoveArea {
                enabled: !root.manual-drag;
                TouchArea {
                    mouse-cursor: grab;
                    accessible-role: button;
                    accessible-label: root.active ? "soc activo. Clic para descansar. Arrastrar para mover" : "soc dormido. Clic para despertar. Arrastrar para mover";
                    pointer-event(event) => {
                        if (root.manual-drag && event.button == PointerEventButton.left && event.kind == PointerEventKind.up) { root.finish-drag(); }
                        if (root.manual-drag && event.button == PointerEventButton.left && event.kind == PointerEventKind.down &&
                            (self.mouse-x - self.width/2) * (self.mouse-x - self.width/2) + (self.mouse-y - self.height/2) * (self.mouse-y - self.height/2) <= self.width * self.width / 4) { root.begin-drag(); }
                    }
                    moved => {
                        if (root.manual-drag && self.pressed) { root.move-drag(); }
                    }
                    clicked => {
                        if ((self.mouse-x - self.width/2) * (self.mouse-x - self.width/2) + (self.mouse-y - self.height/2) * (self.mouse-y - self.height/2) <= self.width * self.width / 4) { focus.focus(); root.face-clicked(); }
                    }
                }
            }
        }
        voice-indicator := ModelIndicator {
            x: orb.x + orb.width / 2 - 31px - root.wake-progress * (root.llm-available ? 34px : 17px);
            y: orb.y + orb.height + 5px;
            voice: true;
            loaded: root.voice-model-loaded;
            description: root.voice-model-tooltip;
        }
        decision-indicator := ModelIndicator {
            x: voice-indicator.x + voice-indicator.width + 6px;
            y: voice-indicator.y;
            loaded: root.decision-model-loaded;
            description: root.decision-model-tooltip;
        }
        new-chat-button := ActionButton {
            x: decision-indicator.x + decision-indicator.width + 6px;
            y: decision-indicator.y - 2px;
            visible: root.active && root.llm-available;
            busy: root.llm-busy;
            clicked => { root.new-chat(); }
        }
        history-button := ActionButton {
            x: (root.llm-available ? new-chat-button.x + new-chat-button.width : decision-indicator.x + decision-indicator.width) + 6px;
            y: decision-indicator.y - 2px;
            visible: root.active;
            history: true;
            clicked => {
                root.history-open = !root.history-open;
                if (root.history-open) {
                    root.open-history();
                }
            }
        }
        history-panel := Rectangle {
            x: orb.x + 24px - self.width;
            y: orb.y + 20px - self.height;
            width: 320px; height: 488px;
            visible: root.active && root.history-open;
            opacity: root.history-open ? 1 : 0;
            animate opacity { duration: root.reduced-motion ? 0ms : 180ms; easing: ease-out; }
            background: transparent;
            Rectangle {
                width: parent.width; height: parent.height;
                border-radius: 22px;
                background: @linear-gradient(135deg, #383838a8 0%, #282828c7 42%, #181818d9 100%);
                border-width: 1px;
                border-color: @linear-gradient(135deg, #ffffff28 0%, #ffffff0a 48%, #ffffff18 100%);
                Rectangle {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    border-radius: 21px;
                    background: @linear-gradient(150deg, #30303078 0%, #17171791 100%);
                }
                Text {
                    x: 20px; y: 20px; width: 110px; height: 25px;
                    text: "Chat"; color: #f7f7f7;
                    font-family: "Helvetica Neue"; font-size: 20px; font-weight: 600;
                }
                Text {
                    x: 20px; y: 48px; width: parent.width - 40px; height: 18px;
                    text: "Mensajes guardados con SOC"; color: #ffffff91;
                    font-family: "Helvetica Neue"; font-size: 12px;
                }
                Rectangle {
                    x: 18px; y: 78px; width: parent.width - 36px; height: 1px;
                    background: #ffffff2b;
                }
                history-scroll := Flickable {
                    x: 20px; y: 94px; width: parent.width - 40px; height: parent.height - 180px;
                    content-height: max(self.height, history-layout.preferred-height + 8px);
                    history-layout := VerticalLayout {
                        x: 0px; y: 0px;
                        width: parent.width; spacing: 10px;
                        for message in root.history-messages: Rectangle {
                            width: 280px;
                            preferred-height: message.system ? 96px : bubble-body.preferred-height + 44px + (message.sources.length > 0 ? 20px + message.sources.length * 26px : 0px);
                            min-height: self.preferred-height; max-height: self.preferred-height;
                            background: transparent;
                            if message.system: Rectangle {
                                x: 12px; y: 3px; width: parent.width - 24px; height: parent.height - 6px;
                                border-radius: 13px; background: #ffffff1c;
                                system-body := Text {
                                    x: 12px; y: 7px; width: parent.width - 24px;
                                    text: message.text; color: #ffffffb0; font-family: "Helvetica Neue";
                                    font-size: 11px; wrap: word-wrap;
                                }
                            }
                            if !message.system: Rectangle {
                                x: message.from-user ? 22px : 0px;
                                width: 258px; height: parent.height;
                                border-radius: 16px;
                                background: message.from-user ? #616161a8 : #292929bc;
                                border-width: 1px;
                                border-color: message.from-user ? #ffffff3e : #ffffff28;
                                Text {
                                    x: 14px; y: 9px; width: 65px; height: 15px;
                                    text: message.title; color: #ffffffbd; font-family: "Helvetica Neue";
                                    font-size: 11px; font-weight: 700;
                                }
                                Text {
                                    x: 76px; y: 9px; width: parent.width - 90px; height: 15px;
                                    text: message.time; color: #ffffff84; font-family: "Helvetica Neue";
                                    font-size: 10px; horizontal-alignment: right;
                                }
                            }
                            bubble-body := Text {
                                x: message.from-user ? 36px : 14px;
                                y: 30px; width: 230px;
                                height: self.preferred-height;
                                visible: !message.system;
                                text: message.text; color: #f2f2f2; font-family: "Helvetica Neue";
                                font-size: 14px; wrap: word-wrap; vertical-alignment: top;
                                accessible-role: text; accessible-label: message.text;
                            }
                            if !message.system && message.sources.length > 0: VerticalLayout {
                                x: message.from-user ? 36px : 14px;
                                y: bubble-body.y + bubble-body.height + 6px;
                                width: 230px;
                                spacing: 2px;
                                Text {
                                    text: "FUENTES"; height: 16px; color: #f2f2f2a8;
                                    font-family: "Helvetica Neue"; font-size: 10px; font-weight: 700;
                                }
                                for source in message.sources: Rectangle {
                                    height: 24px; background: transparent;
                                    Text {
                                        x: 0px; y: 2px; width: parent.width; height: 20px;
                                        text: "↗ " + source.label; color: #d4d4d4;
                                        font-family: "Helvetica Neue"; font-size: 12px; overflow: elide;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer; accessible-role: button;
                                        accessible-label: "Abrir fuente " + source.label;
                                        clicked => { root.open-source(source.url); }
                                    }
                                    Tooltip { text: @markdown("Abrir fuente en el navegador"); }
                                }
                            }
                        }
                    }
                    if root.history-messages.length == 0: Text {
                        x: 0px; y: 0px; width: parent.width;
                        text: root.history-notice; color: #ffffffb8; font-family: "Helvetica Neue";
                        font-size: 14px; wrap: word-wrap;
                    }
                }
                scrollbar-track := Rectangle {
                    x: parent.width - 11px; y: history-scroll.y;
                    width: 2px; height: history-scroll.height;
                    visible: history-scroll.content-height > history-scroll.height;
                    border-radius: 1px; background: #ffffff1c; clip: true;
                    scrollbar-thumb := Rectangle {
                        x: 0px;
                        y: history-scroll.content-height > history-scroll.height ?
                            min(max(0px, -history-scroll.content-y), history-scroll.content-height - history-scroll.height) / (history-scroll.content-height - history-scroll.height) * (parent.height - self.height) : 0px;
                        width: parent.width;
                        height: max(28px, history-scroll.height * history-scroll.height / history-scroll.content-height);
                        border-radius: 1px; background: #ffffff78;
                    }
                }
                Rectangle {
                    x: 18px; y: parent.height - 72px; width: parent.width - 36px; height: 1px;
                    background: #ffffff2b;
                }
                Rectangle {
                    x: 18px; y: parent.height - 62px; width: parent.width - 36px; height: 42px;
                    border-radius: 10px;
                    background: #ffffff11;
                    border-width: 1px; border-color: #ffffff30;
                    if root.history-draft == "": Text {
                        x: 12px; y: 8px; width: parent.width - 54px; height: 26px;
                        text: root.llm-available ? "Escribe a SOC…" : "Conversación no disponible";
                        color: #ffffff85; font-family: "Helvetica Neue"; font-size: 13px;
                        vertical-alignment: center;
                    }
                    chat-input := TextInput {
                        x: 12px; y: 8px; width: parent.width - 54px; height: 26px;
                        text <=> root.history-draft;
                        enabled: root.llm-available;
                        single-line: true; color: #f2f2f2;
                        font-family: "Helvetica Neue"; font-size: 13px;
                        vertical-alignment: center;
                        accepted => {
                            if (root.send-chat(root.history-draft)) { root.history-draft = ""; }
                        }
                    }
                    Rectangle {
                        x: parent.width - 38px; y: 6px; width: 30px; height: 30px;
                        border-radius: 10px;
                        background: root.llm-available && !root.llm-busy && root.history-draft != "" ? #ffffff30 : #ffffff12;
                        Text {
                            text: "↑"; color: #f2f2f2; font-size: 18px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer; accessible-role: button; accessible-label: "Enviar mensaje";
                            clicked => {
                                if (root.send-chat(root.history-draft)) { root.history-draft = ""; }
                            }
                        }
                    }
                }
                Text {
                    x: 20px; y: parent.height - 17px; width: parent.width - 40px; height: 14px;
                    text: root.history-send-status; color: #ffffffb8;
                    font-family: "Helvetica Neue"; font-size: 10px; overflow: elide;
                }
                Rectangle {
                    x: parent.width - 181px; y: 17px; width: 120px; height: 30px;
                    border-radius: 10px;
                    background: !root.llm-available || root.llm-busy ? #ffffff0b : history-new-chat-hover.has-hover ? #ffffff30 : #ffffff19;
                    border-width: 1px; border-color: !root.llm-available || root.llm-busy ? #ffffff25 : #ffffff54;
                    Text {
                        text: "+  Nuevo chat";
                        color: !root.llm-available || root.llm-busy ? #ffffff69 : #f2f2f2;
                        font-size: 12px; font-family: "Helvetica Neue";
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    history-new-chat-hover := TouchArea {
                        mouse-cursor: root.llm-available && !root.llm-busy ? pointer : default;
                        accessible-role: button; accessible-label: "Nuevo chat";
                        clicked => { if (root.llm-available && !root.llm-busy) { root.new-chat(); } }
                    }
                }
                Rectangle {
                    x: parent.width - 47px; y: 17px; width: 30px; height: 30px;
                    border-radius: 15px; background: close-hover.has-hover ? #ffffff2c : #ffffff12;
                    border-width: 1px; border-color: #ffffff38;
                    Text { text: "×"; color: #ffffffd9; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    close-hover := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: "Cerrar chat";
                        clicked => { root.history-open = false; }
                    }
                }
            }
        }
        if (root.sleep-opacity > 0): Text {
            x: orb.x + orb.width - 8px + root.dream-phase * 5px;
            y: orb.y - 6px - root.dream-phase * 30px;
            text: "z"; font-size: 16px + root.dream-phase * 8px;
            font-weight: 600; color: #a3a3a3;
            opacity: root.sleep-opacity * (root.reduced-motion ? 0.8 :
                Math.sin(root.dream-phase * 180deg) * 0.8);
        }
        if (root.sleep-opacity > 0): Text {
            x: orb.x + orb.width - 2px + root.second-dream-phase * 8px;
            y: orb.y - 16px - root.second-dream-phase * 32px;
            text: "z"; font-size: 14px; color: #a3a3a3;
            opacity: root.sleep-opacity * (root.reduced-motion ? 0.5 :
                Math.sin(root.second-dream-phase * 180deg) * 0.55);
        }
    }
}
